# SecureHemas Server Environment Configuration Example
PORT=5000
NODE_ENV=development

# MySQL Database Connection URL
DATABASE_URL="mysql://root@localhost:3306/ispm"

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Email Configuration
EMAIL_USER=securehemasservice@gmail.com
EMAIL_PASSWORD=your_gmail_16_char_app_password
EMAIL_FROM="SecureHemas <securehemasservice@gmail.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
